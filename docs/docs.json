{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Rail402",
  "description": "x402 facilitator and Bazaar discovery layer for Stellar.",
  "colors": {
    "primary": "#E23E00",
    "light": "#FF7A47",
    "dark": "#C43D00"
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "favicon": "/favicon.svg",
  "variables": {
    "facilitatorUrl": "https://testnet.rail402.dev"
  },
  "banner": {
    "content": "Rail402 is live on `stellar:testnet`, free and without an API key. [Try the hosted facilitator →](/facilitator/hosted-testnet)",
    "dismissible": true
  },
  "appearance": {
    "default": "light"
  },
  "background": {
    "decoration": "grid",
    "color": {
      "light": "#FCFBF9",
      "dark": "#0E0E10"
    }
  },
  "fonts": {
    "heading": {
      "family": "Space Grotesk",
      "weight": 600
    },
    "body": {
      "family": "Archivo",
      "weight": 400
    }
  },
  "styling": {
    "eyebrows": "section",
    "codeblocks": {
      "theme": {
        "light": "github-light",
        "dark": "github-dark"
      }
    }
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude", "perplexity", "cursor", "vscode"]
  },
  "seo": {
    "indexing": "all"
  },
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "GitHub",
          "icon": "github",
          "href": "https://github.com/tolgayayci/rail402"
        },
        {
          "anchor": "x402 specification",
          "icon": "book",
          "href": "https://github.com/x402-foundation/x402"
        }
      ]
    },
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Start here",
            "pages": ["index", "architecture/overview", "install"]
          },
          {
            "group": "Sell",
            "pages": ["paths/sell", "quickstart/sellers", "sellers/helpers"]
          },
          {
            "group": "Buy and build agents",
            "pages": [
              "paths/buy",
              "quickstart/buyers",
              "agents/sdk",
              "agents/mcp-server",
              "agents/hosted-mcp",
              "agents/cli"
            ]
          },
          {
            "group": "Operate a facilitator",
            "pages": [
              "paths/operate",
              "facilitator/hosted-testnet",
              "facilitator/hosted-mainnet",
              "facilitator/docker",
              "facilitator/in-process",
              "facilitator/assets",
              "facilitator/upto",
              "configuration",
              "operations",
              "runbook"
            ]
          },
          {
            "group": "Bazaar",
            "pages": ["bazaar/cataloging", "bazaar/discovery", "bazaar/search"]
          },
          {
            "group": "Playground",
            "pages": ["playground/overview", "playground/how-it-works", "playground/self-host"]
          },
          {
            "group": "Explorer",
            "pages": ["explorer/index", "explorer/api"]
          },
          {
            "group": "Security",
            "pages": [
              "security/report",
              "security/threat-model",
              "security/data-flow",
              "security/operational-tests"
            ]
          },
          {
            "group": "Reference",
            "pages": [
              "verification-rules",
              "reference/error-codes",
              "reference/upto-contract",
              "reference/spending-policy",
              "reference/egress",
              "reference/secret-handling",
              "reference/conformance",
              "reference/search-evaluation",
              "reference/load-test",
              "reference/indexing-rules",
              "reference/explorer-rebuild",
              "dependency-licenses"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "groups": [
          {
            "group": "Overview",
            "pages": ["api-reference/overview"]
          },
          {
            "group": "Endpoints",
            "openapi": {
              "source": "api-reference/openapi.yaml",
              "directory": "api-reference/endpoints"
            }
          }
        ]
      },
      {
        "tab": "Agents",
        "groups": [
          {
            "group": "Coding agents",
            "pages": ["coding-agents/overview"]
          }
        ]
      }
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/tolgayayci/rail402"
    }
  }
}
