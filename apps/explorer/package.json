{
  "name": "@rail402/explorer",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "x402 payments explorer for Stellar: ingest, classify, and serve settlement activity.",
  "type": "module",
  "main": "./dist/lib.js",
  "types": "./dist/lib.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "default": "./dist/lib.js"
    },
    "./server": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint src"
  },
  "dependencies": {
    "@rail402/agent-helpers": "workspace:*",
    "@rail402/errors": "workspace:*",
    "@stellar/stellar-sdk": "^16.2.0",
    "@hono/node-server": "^2.0.5",
    "hono": "^4.12.0",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "tsx": "^4.21.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
