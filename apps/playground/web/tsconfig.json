{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../../tsconfig.base.json",
  // The browser program: DOM types, no Node types, so a Node-only API reached from the page's code
  // (its own, the shared contracts or a workspace package's sources) fails the type check.
  "compilerOptions": {
    "lib": ["es2024", "dom", "dom.iterable"],
    "types": ["vite/client"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "customConditions": ["@rail402/source"]
  },
  "include": ["src"]
}
