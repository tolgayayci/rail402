# ── Rail402 playground configuration ──────────────────────────────────────────
# Testnet-only by design (it hands strangers a funded wallet). There is no network knob.

# ── Required ──────────────────────────────────────────────────────────────────
# The dispenser wallet: a testnet account HOLDING USDC that drips to fresh sessions and to the
# Agents scene's smart accounts, and receives the demo payments back (closing the loop). Provision
# and fund it from the Circle testnet faucet — friendbot cannot mint USDC. Never commit a real secret.
PLAYGROUND_DISPENSER_SECRET=S...

# ── Facilitator ───────────────────────────────────────────────────────────────
# The facilitator every demo flow verifies and settles through.
PLAYGROUND_FACILITATOR_URL=https://facilitator.rail402.dev

# ── Public URL ────────────────────────────────────────────────────────────────
# The playground's own public origin. Behind Railway's proxy the request host is internal, so 402
# challenges and discovery metadata need the real one. Set to the deployed URL.
# PLAYGROUND_PUBLIC_URL=https://playground.rail402.dev

# ── CORS ──────────────────────────────────────────────────────────────────────
# The playground exists to be called from a browser. Default is open ("*"); pin it to the frontend
# origin in production.
# PLAYGROUND_CORS_ORIGINS=https://playground.rail402.dev

# ── Amounts (stroops, 7 decimals) ─────────────────────────────────────────────
# Defaults are sane; override only to tune the demo economics.
# PLAYGROUND_DRIP_STROOPS=5000000          # 0.5 USDC per fresh session
# PLAYGROUND_EXACT_PRICE_STROOPS=500000    # 0.05 USDC — the exact demo endpoint
# PLAYGROUND_METER_UNIT_STROOPS=70000      # 0.007 USDC — one metered call

# ── Dispenser rate limits ─────────────────────────────────────────────────────
# PLAYGROUND_RATE_WINDOW_SECONDS=3600
# PLAYGROUND_RATE_MAX_PER_IP=6
# PLAYGROUND_RATE_MAX_PER_ACCOUNT=2

# ── Port ──────────────────────────────────────────────────────────────────────
# Railway sets PORT; the Dockerfile defaults it to 8090.
# PORT=8090
# LOG_LEVEL=info
