{
  "name": "@rail402.dev/mcp-discovery",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "MCP server exposing Stellar Bazaar search and a budget-capped paid-call proxy to agents.",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "rail402-mcp": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "tsx src/index.ts",
    "dev:http": "tsx src/serve-http.ts",
    "start": "node dist/index.js",
    "start:http": "node dist/serve-http.js",
    "cli": "node dist/cli.js",
    "lint": "eslint src"
  },
  "dependencies": {
    "@rail402.dev/agent-helpers": "workspace:*",
    "@rail402.dev/errors": "workspace:*",
    "@rail402.dev/scheme-upto-stellar": "workspace:*",
    "@hono/node-server": "^2.0.5",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "hono": "^4.12.0",
    "@x402/core": "2.20.0",
    "@x402/fetch": "2.20.0",
    "@x402/mcp": "2.20.0",
    "@x402/stellar": "2.20.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "tsx": "^4.21.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tolgayayci/x402-stellar.git",
    "directory": "apps/mcp-discovery"
  },
  "homepage": "https://rail402.dev",
  "bugs": {
    "url": "https://github.com/tolgayayci/x402-stellar/issues"
  }
}
