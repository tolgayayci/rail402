{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Rail402",
  "description": "x402 facilitator, Bazaar discovery, and agent tooling on Stellar.",
  "colors": {
    "primary": "#E23E00",
    "light": "#FF7A47",
    "dark": "#C43D00"
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://rail402.dev"
  },
  "favicon": "/favicon.svg",
  "banner": {
    "content": "Rail402 is live on `stellar:testnet`. [Test it in the API playground →](/api-reference/facilitator/info/list-supported-schemes-and-networks)",
    "dismissible": true
  },
  "appearance": {
    "default": "light"
  },
  "background": {
    "decoration": "grid",
    "color": {
      "light": "#FCFBF9",
      "dark": "#0E0E10"
    }
  },
  "fonts": {
    "heading": {
      "family": "Space Grotesk",
      "weight": 600
    },
    "body": {
      "family": "Archivo",
      "weight": 400
    }
  },
  "styling": {
    "eyebrows": "section",
    "codeblocks": {
      "theme": {
        "light": "github-light",
        "dark": "github-dark"
      }
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "assistant",
      "claude",
      "chatgpt",
      "perplexity",
      "grok",
      "aistudio",
      "cursor",
      "vscode",
      "devin",
      "mcp",
      "add-mcp",
      "download-spec",
      {
        "title": "Try in Rail402 Playground",
        "description": "Open the live testnet playground",
        "icon": "flask",
        "href": {
          "base": "https://playground.rail402.dev",
          "query": [{ "key": "ref", "value": "$path" }]
        }
      }
    ]
  },
  "markdown": {
    "instructions": [
      "Rail402 is an x402 payment facilitator, Stellar-native Bazaar discovery layer, and agent tooling for the Stellar network. It currently targets stellar:testnet.",
      "The live testnet facilitator is https://facilitator.rail402.dev with endpoints /verify, /settle, /supported, /health, and /discovery/*.",
      "Payment amounts use 7-decimal SEP-41 integer (stroop) arithmetic. Never use floating-point math for amounts.",
      "Every rejection returns a machine-readable error code and a non-null human-readable reason. When explaining a failure, surface both."
    ]
  },
  "seo": {
    "indexing": "all"
  },
  "search": {
    "prompt": "Search or ask the Rail402 docs…"
  },
  "navigation": {
    "global": {
      "anchors": [
        { "anchor": "Rail402 GitHub", "icon": "github", "href": "https://github.com/tolgayayci/rail402" },
        { "anchor": "Rail402 Explorer", "icon": "compass", "href": "https://explorer.rail402.dev" },
        { "anchor": "Rail402 Playground", "icon": "flask", "href": "https://playground.rail402.dev" }
      ]
    },
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          { "group": "Start here", "pages": ["index", "start/how-it-works", "start/quickstart"] },
          { "group": "Buyers & agents", "pages": ["buyers/quickstart", "buyers/sign-and-pay", "buyers/discover", "buyers/spend-controls", "buyers/smart-accounts", "buyers/mcp", "buyers/cli"] },
          { "group": "Sellers", "pages": ["sellers/quickstart", "sellers/get-discovered", "sellers/mcp-tool", "sellers/upto", "sellers/self-facilitation", "sellers/preflight"] },
          { "group": "Operators", "pages": ["operators/run", "operators/configuration", "operators/bazaar", "operators/mcp-server", "operators/operations", "operators/security"] },
          { "group": "Concepts", "pages": ["concepts/payment-loop", "concepts/exact", "concepts/upto", "concepts/bazaar", "concepts/search", "concepts/stellar"] },
          { "group": "Reference", "pages": ["reference/packages", "reference/sdk", "reference/cli", "reference/errors", "reference/conformance"] },
          { "group": "Support", "pages": ["support/faq", "support/troubleshooting"] }
        ]
      },
      {
        "tab": "Architecture",
        "groups": [
          { "group": "Overview", "pages": ["architecture/overview", "architecture/proofs"] },
          { "group": "Settlement on Stellar", "pages": ["architecture/settlement", "architecture/fees", "architecture/expiration-replay", "architecture/stellar-engineering"] },
          { "group": "Metered payments (upto)", "pages": ["architecture/upto", "architecture/smart-accounts"] },
          { "group": "Discovery & agents", "pages": ["architecture/discovery", "architecture/mcp"] },
          { "group": "Search & retrieval", "pages": ["architecture/retrieval", "architecture/evaluation", "architecture/reproduce"] },
          { "group": "Conformance & operations", "pages": ["architecture/conformance", "architecture/deployment"] }
        ]
      },
      {
        "tab": "API reference",
        "groups": [
          { "group": "Facilitator", "openapi": { "source": "api-reference/facilitator.openapi.yaml", "directory": "api-reference/facilitator" } },
          { "group": "Explorer", "openapi": { "source": "api-reference/explorer.openapi.yaml", "directory": "api-reference/explorer" } }
        ]
      }
    ]
  }
}
