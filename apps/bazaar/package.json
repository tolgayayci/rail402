{
  "name": "@rail402.dev/bazaar",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "Stellar-native Bazaar: catalog, automatic cataloging, and natural-language discovery.",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node copy-weights.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "eval": "tsx src/search/evaluate.ts",
    "eval:pack": "node eval-pack/build.mjs",
    "eval:scale": "tsx src/search/evaluate-scale.ts",
    "ablation": "tsx src/search/ablation.ts",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint src"
  },
  "dependencies": {
    "@rail402.dev/errors": "workspace:*",
    "@x402/core": "2.20.0",
    "@x402/extensions": "2.20.0",
    "@hono/node-server": "^2.0.5",
    "hono": "^4.12.0",
    "zod": "^4.4.3",
    "smol-toml": "^1.7.1"
  },
  "devDependencies": {
    "tsx": "^4.21.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "types": "./dist/exports.d.ts",
  "exports": {
    ".": {
      "types": "./dist/exports.d.ts",
      "default": "./dist/exports.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tolgayayci/rail402.git",
    "directory": "apps/bazaar"
  },
  "homepage": "https://rail402.dev",
  "bugs": {
    "url": "https://github.com/tolgayayci/rail402/issues"
  }
}
