# ── Minimum viable config ─────────────────────────────────────────────────────
# A funded Stellar account that pays settlement fees. Testnet: fund via friendbot.
# Never commit a real secret.
FACILITATOR_STELLAR_SECRET=S...

# ── Networks ──────────────────────────────────────────────────────────────────
# Comma-separated CAIP-2 ids. Both networks are supported deliverables.
STELLAR_NETWORKS=stellar:testnet
# STELLAR_NETWORKS=stellar:testnet,stellar:pubnet

STELLAR_TESTNET_RPC_URL=https://soroban-testnet.stellar.org
# REQUIRED when stellar:pubnet is enabled — @x402/stellar ships no mainnet default and the
# service refuses to start without it rather than failing on a real payment.
# STELLAR_PUBNET_RPC_URL=https://mainnet.sorobanrpc.com

# ── Throughput ────────────────────────────────────────────────────────────────
# Agent traffic is bursty and one account settles ~one transaction per ledger. Each channel
# secret is an independent source account with its own sequence number; the facilitator
# round-robins across them. Fund every channel account before use.
# FACILITATOR_STELLAR_CHANNEL_SECRETS=S...,S...,S...
#
# Optional separate fee source, so paying fees does not contend for sequence numbers.
# FACILITATOR_STELLAR_FEE_BUMP_SECRET=S...

# ── Safety ceiling ────────────────────────────────────────────────────────────
# Circuit breaker, not a price. The @x402/stellar default is 50,000, which Stellar's reference
# facilitator documents as too low for some real Soroban resource fees; we default higher.
# Enforced for BOTH exact and upto. A smart-account (C-address) payment cross-calls a signature
# verifier and a spending policy, so it costs several times a keypair payment — measured ~216,000
# (exact) and ~174,000 (upto) stroops on testnet. To serve smart-account buyers, raise this to e.g.
# 500000; the 100,000 default correctly refuses them with a legible reason.
MAX_TRANSACTION_FEE_STROOPS=100000

# Sponsorship is effectively fixed to true: the exact scheme settles by rebuilding the transaction
# with a facilitator-funded source, which IS sponsorship, so FEES_SPONSORED=false is rejected at
# startup rather than advertised falsely.
# FEES_SPONSORED=true

# ── Access control ────────────────────────────────────────────────────────────
# Unset ⇒ the facilitator is OPEN. That is the intended default: testnet must be free and
# usable without friction. No fee is hard-wired anywhere in this service.
# FACILITATOR_API_KEYS=key-one,key-two
#
# Networks that stay open even when API keys are set — e.g. charge for pubnet, keep testnet free.
AUTH_EXEMPT_NETWORKS=stellar:testnet

RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120

# ── Service ───────────────────────────────────────────────────────────────────
PORT=4022
HOST=0.0.0.0
# Structured JSON logs (pino). One of: trace, debug, info, warn, error, fatal.
LOG_LEVEL=info
# CORS_ORIGINS=https://example.com
# Set to true ONLY when a trusted proxy sits in front and sets/strips the client-IP headers
# (cf-connecting-ip, x-real-ip, x-forwarded-for). Without it those headers are ignored for rate
# limiting and the socket address is used, because a client can otherwise forge them to get a fresh
# bucket every request. A Cloudflare/Workers deployment should set this to true.
# TRUST_PROXY=true

# ── Catalog durability ───────────────────────────────────────────────────────
# Where the Bazaar catalog is persisted. Unset ⇒ in-memory, and a restart forgets every listing.
# That is fine for a test and wrong for a deployment: the catalog is derived state in principle, but
# nothing replays settlement history to rebuild it, so sellers vanish until each pays again.
#
# Uses Node's built-in SQLite — no new dependency, no service to run, one file to back up. Search
# ranking is identical either way; the store is storage, and a lexical prefilter was measured and
# rejected (apps/bazaar/src/search/fts5-prefilter.test.ts). /health reports catalog.storage as
# memory | durable | degraded.
# CATALOG_DB_PATH=/var/lib/x402-stellar/catalog.db
