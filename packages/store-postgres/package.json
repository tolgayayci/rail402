{
  "name": "@rail402.dev/store-postgres",
  "version": "0.2.1",
  "description": "Postgres storage for Rail402: settlement ledger, channel leases and migrations.",
  "license": "Apache-2.0",
  "keywords": [
    "x402",
    "stellar",
    "postgres"
  ],
  "homepage": "https://docs.rail402.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tolgayayci/rail402.git",
    "directory": "packages/store-postgres"
  },
  "bugs": {
    "url": "https://github.com/tolgayayci/rail402/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@rail402/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@rail402.dev/bazaar": "workspace:*",
    "@rail402.dev/facilitator": "workspace:*",
    "@x402/core": "catalog:",
    "kysely": "catalog:",
    "pg": "catalog:"
  },
  "devDependencies": {
    "@types/pg": "catalog:",
    "vitest": "catalog:",
    "@rail402.dev/bazaar": "workspace:*"
  },
  "engines": {
    "node": ">=24.11"
  },
  "publishConfig": {
    "access": "public"
  }
}
