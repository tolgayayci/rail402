{
  "name": "@rail402.dev/facilitator",
  "version": "0.2.0",
  "description": "x402 facilitator for Stellar: strict verification and idempotent, crash-safe settlement on @x402/stellar.",
  "license": "Apache-2.0",
  "keywords": [
    "x402",
    "stellar",
    "facilitator",
    "settlement"
  ],
  "homepage": "https://docs.rail402.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tolgayayci/rail402.git",
    "directory": "packages/facilitator"
  },
  "bugs": {
    "url": "https://github.com/tolgayayci/rail402/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@rail402/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "@rail402/source": "./src/testing.ts",
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@rail402.dev/errors": "workspace:*",
    "@rail402.dev/stellar": "workspace:*",
    "@stellar/stellar-sdk": "catalog:",
    "@x402/core": "catalog:",
    "@x402/stellar": "catalog:"
  },
  "devDependencies": {
    "@rail402.dev/testkit": "workspace:*",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24.11"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "vitest": ">=4"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  }
}
