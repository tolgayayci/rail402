# secrets
.env
.env.*
!.env.example
# Lumeus keys for the local Explorer (apps/explorer/compose.yaml)
lumeus-*.key
# node
node_modules/
.pnpm-store/
dist/
.next/
.turbo/
.cache/
coverage/
*.log
# python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
# rust / go
target/
# editors / os
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
# build output
*.tsbuildinfo
# local runtime data (postgres volumes, downloaded embedding models)
.data/
.models/
# local test and tooling output (code coverage records)
.work/

# search evaluation output (the tagged report lives in tools/search-eval/data)
tools/search-eval/results/

# Judge packets are generated (src/build/pool.ts, src/build/public.ts); the judged copies are in packets.tar.gz
tools/search-eval/construction/judging/*/packets/
tools/search-eval/construction/judging/*/packets-public/

# soroban test snapshots written by contract unit tests
contracts/**/test_snapshots/

# Playground browser tests and Vite cache
apps/playground/test-results/
apps/playground/playwright-report/
apps/playground/web/.vite/

# load test runs (tools/loadtest): raw requests, summaries and configuration
tools/loadtest/results/

# Lockfiles of the standalone examples, created by `npm install` inside them
examples/*/package-lock.json

# The local list of words the findings register refuses (tools/conformance/src/findings.ts)
/.forbidden-words
