# The explorer: ingest worker + classifier + SQLite system-of-record + read API, one Node process.
#
# Deliberately a SEPARATE image and a separate deployment from the facilitator: the explorer talks
# to facilitators only over their public HTTP surfaces (/supported, /discovery/*) and to the ledger
# only over public Soroban RPC / Horizon. It holds no keys, shares no database and no code path with
# the facilitator at runtime — which is the point: any third-party facilitator is observed through
# exactly the same interfaces ours is (apps/explorer/README.md).
#
# Node 24: `node:sqlite` needs >= 22.5; slim rather than alpine for glibc (stellar-sdk).
FROM node:24-slim AS build
WORKDIR /app
RUN corepack enable
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json tsconfig.base.json turbo.json ./
COPY packages ./packages
COPY apps ./apps
COPY scripts ./scripts
# `--frozen-lockfile` so the image can never silently resolve a different dependency tree than the
# one the licence gate scanned.
RUN pnpm install --frozen-lockfile --ignore-scripts
RUN pnpm --filter @rail402.dev/explorer... build

FROM node:24-slim
WORKDIR /app
ENV NODE_ENV=production
# The payment history lives here — the explorer is the system of record (a testnet reset wipes
# Core, Horizon AND RPC), so this volume matters more than most. Root for the same reason as the
# facilitator image: managed hosts mount volumes root-owned (SQLITE_CANTOPEN otherwise).
RUN mkdir -p /data
COPY --from=build /app /app
EXPOSE 8080
ENV PORT=8080 HOST=0.0.0.0 EXPLORER_DB_PATH=/data/explorer.db
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||8080)+'/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "apps/explorer/dist/index.js"]
