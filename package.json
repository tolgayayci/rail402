{
  "name": "rail402",
  "version": "0.4.2",
  "private": true,
  "license": "Apache-2.0",
  "description": "x402 facilitator and Bazaar discovery layer for Stellar.",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.11"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/playground/web && tsc -p apps/playground/web/test",
    "lint": "eslint .",
    "format": "prettier --write . --ignore-path .gitignore --ignore-path .prettierignore --ignore-path .git/info/exclude",
    "format:check": "prettier --check . --ignore-path .gitignore --ignore-path .prettierignore --ignore-path .git/info/exclude",
    "test": "vitest run --project unit --project web",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --project unit --project web --coverage",
    "license:gate": "node tools/license-gate/src/main.ts --check-report",
    "license:report": "node tools/license-gate/src/main.ts --write-report",
    "pack:check": "node tools/pack-check/src/main.ts",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm license:gate",
    "clean": "pnpm -r exec rm -rf dist",
    "models:fetch": "node --conditions=@rail402/source tools/models/src/fetch.ts",
    "eval": "node --conditions=@rail402/source tools/search-eval/src/main.ts",
    "eval:check": "node --conditions=@rail402/source tools/search-eval/src/main.ts --check",
    "report": "node --conditions=@rail402/source tools/conformance/src/report.ts",
    "report:check": "node --conditions=@rail402/source tools/conformance/src/report.ts --check",
    "evidence": "bash tools/conformance/run-evidence.sh",
    "codes:coverage": "node --conditions=@rail402/source tools/conformance/src/codes-coverage.ts",
    "upstream:export": "node tools/upstream-export/src/main.ts"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@rail402.dev/demo-seller": "workspace:*",
    "@rail402.dev/sdk": "workspace:*",
    "@rail402.dev/stellar": "workspace:*",
    "@rail402.dev/testkit": "workspace:*",
    "@stellar/stellar-sdk": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@x402/core": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "railway": "3.11.0",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  }
}
